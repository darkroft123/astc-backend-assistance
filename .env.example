# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=assistance_db
DB_USERNAME=assistance_user
DB_PASSWORD=assistance_pass

# JWT
JWT_PUBLIC_KEY_LOCATION=publicKey.pem
JWT_ISSUER=https://smms.auth.example.com

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=assistance

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# OpenTelemetry
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
