# =========================
# DATABASE
# =========================
DB_HOST=astc-assistance-postgres
DB_PORT=5432
DB_NAME=assistance_db
DB_USERNAME=assistance_user
DB_PASSWORD=assistance_pass

# =========================
# JWT
# =========================
JWT_PUBLIC_KEY_LOCATION=publicKey.pem
JWT_ISSUER=https://smms.auth.example.com

# =========================
# MINIO
# =========================
S3_ENDPOINT=http://astc-minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=assistance

# =========================
# REDIS
# =========================
REDIS_URL=redis://astc-redis:6379

# =========================
# RABBITMQ
# =========================
RABBITMQ_HOST=astc-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# =========================
# OTEL
# =========================
OTEL_ENABLED=false
OTEL_ENDPOINT=http://otel-collector:4317